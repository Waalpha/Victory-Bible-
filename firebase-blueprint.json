{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile for authentication and institutional role access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user account" },
        "uid": { "type": "string", "description": "Firebase Auth UID or unique credentials identifier" },
        "email": { "type": "string", "format": "email", "description": "Institutional email address" },
        "fullName": { "type": "string", "description": "Full legal or institutional name" },
        "role": { 
          "type": "string", 
          "description": "Institutional permission tier", 
          "enum": ["SUPER_ADMIN", "ADMIN"] 
        },
        "department": { "type": "string", "description": "Associated academic or administrative department" },
        "phoneNumber": { "type": "string", "description": "Contact telephone number" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"], "description": "Account status" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last sign in" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" }
      },
      "required": ["id", "email", "fullName", "role", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record in the Theological ERP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "programId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentNumber", "fullName", "email", "status"]
    },
    "InstitutionWebsiteSettings": {
      "title": "InstitutionWebsiteSettings",
      "description": "Multi-tenant institution website branding and logo configuration",
      "type": "object",
      "properties": {
        "institutionId": { "type": "string" },
        "logoUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["institutionId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User accounts and authentication profiles"
    },
    "/institutions/{institutionId}/settings/{settingId}": {
      "schema": "InstitutionWebsiteSettings",
      "description": "Institution branding and website customization settings"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student academic and demographic records"
    }
  }
}
