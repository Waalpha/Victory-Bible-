rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public website assets and public directories (read allowed for everyone)
    match /websiteHeroSlides/{id} {
      allow read: if true;
      allow write: if request.auth != null || true; // Allowed in prototype mode
    }

    match /websiteSettings/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /newsArticles/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /publicEvents/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /programs/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /staff/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Public contact message submissions
    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null || true;
    }

    // Public applications
    match /applicants/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null || true;
    }

    // Institutional user accounts and authentication profiles
    match /users/{userId} {
      allow read, write: if request.auth != null || true;
    }

    // Multi-tenant institution branding & website settings
    match /institutions/{institutionId}/settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // ERP Core collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
